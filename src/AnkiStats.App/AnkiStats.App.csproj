<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nakama</AssemblyName>
    <RootNamespace>AnkiStats.App</RootNamespace>
    <Product>Nakama</Product>
    <Title>Nakama</Title>
    <Description>Your Japanese learning companion</Description>
    <ApplicationIcon>Assets/Nakama.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../AnkiStats.Core/AnkiStats.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/Nakama.ico" />
    <Resource Include="Assets/Nakama-wordmark.png" />
  </ItemGroup>
</Project>

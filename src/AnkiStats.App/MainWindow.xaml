<Window x:Class="AnkiStats.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AnkiStats.App" Title="Anki Stats" Width="1320" Height="880" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#20232B" Padding="18,30,12,20">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="anki stats" FontSize="27" FontWeight="SemiBold" Margin="10,0,0,4"/>
          <TextBlock Text="A closer look at your learning" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,36"/>
          <Button Content="Overview" Tag="Overview" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button Content="Vocabulary" Tag="Vocabulary" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Word Coverage" Tag="Word Coverage" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Reviews" Tag="Reviews" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Insights" Tag="Insights" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Calendar" Tag="Calendar" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Time Analysis" Tag="Time Analysis" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Learning Patterns" Tag="Learning Patterns" Click="Navigate" Margin="0,0,0,8"/>
          <Button Content="Settings" Tag="Settings" Click="Navigate" Margin="0,20,0,8"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Text="LOCAL · YOU CONTROL ADDITIONS" Foreground="#8FB8EB" FontSize="10" Margin="10,0,0,10"/>
          <TextBlock Text="Refresh with Anki closed. Open Anki to explicitly create new notes in Word Coverage." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="10,0,8,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="30,26,24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18">
        <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻  Refresh" Click="RefreshClick" Background="#3D659B" Margin="12,0,0,0"/>
        <StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="LastRefresh" Text="Connect a collection to get started" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="SourceInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/><TextBlock x:Name="TestDataBanner" Text="TEST SESSION · isolated app data. These results may be synthetic; they are not your normal connected collection." Foreground="#FFD28F" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Active profile" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="ActiveProfilePicker" DisplayMemberPath="Name" SelectionChanged="ActiveProfileChanged" AutomationProperties.Name="Active deck profile" MinWidth="220" IsEnabled="False"/></StackPanel></StackPanel>
      </DockPanel>
      <Border x:Name="StatusPanel" Grid.Row="1" Background="#283446" CornerRadius="6" Padding="12" Margin="0,0,0,14"><TextBlock x:Name="StatusText" Text="Choose your profile in Settings. No Anki data is modified." TextWrapping="Wrap"/></Border>
      <ProgressBar x:Name="Progress" Grid.Row="2" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
      <Grid Grid.Row="3">
        <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="OverviewScope" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <UniformGrid x:Name="OverviewMetrics" Columns="4">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Vocabulary entries" Foreground="{StaticResource Muted}"/><TextBlock x:Name="VocabularyCount" Text="—" FontSize="40" Margin="0,8"/><TextBlock x:Name="InventoryBreakdown" Text="Distinct entries · all card states" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/><Button Content="Explore vocabulary →" Tag="Vocabulary" Click="Navigate" Margin="0,18,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Total review answers" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ReviewCount" Text="—" FontSize="40" Margin="0,8"/><TextBlock x:Name="ReviewBreakdown" Text="Learning + review + relearning + filtered" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/><Button Content="Explore review history →" Tag="Reviews" Click="Navigate" Margin="0,18,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Again rate" Foreground="{StaticResource Muted}"/><TextBlock x:Name="AgainRate" Text="—" FontSize="40" Margin="0,8"/><TextBlock Text="Again ÷ ordinary review answers" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock Text="A record of answers, not a fluency score." TextWrapping="Wrap" FontSize="12" Margin="0,20,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recorded review time" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RecordedHours" Text="—" FontSize="40" Margin="0,8"/><TextBlock x:Name="RecordedTimeScope" Text="All rated answers · all history" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/><Button Content="Explore time analysis →" Tag="Time Analysis" Click="Navigate" Margin="0,18,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Vocabulary coverage" FontSize="20"/><TextBlock x:Name="CoverageOverview" Text="Open Word Coverage to install the local reference data." TextWrapping="Wrap" Margin="0,10,0,0"/><Button Content="Explore common words and JLPT →" Tag="Word Coverage" Click="Navigate" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="TODAY'S DISCOVERY" Foreground="#8FB8EB" FontSize="11"/><TextBlock x:Name="InsightTitle" Text="Connect your collection for a daily observation" FontSize="23" Margin="0,10,0,8"/><TextBlock x:Name="InsightDetail" Text="Refresh a collection to uncover your first observation." TextWrapping="Wrap" FontSize="16" LineHeight="25"/><TextBlock x:Name="InsightMethod" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" LineHeight="20"/></StackPanel></Border>
            <StackPanel x:Name="RhythmCharts"/>
            <TextBlock Text="Inventory includes all selected card states. Word Coverage separates known (永遠), familiar (勉強してる), and vocabulary in the imported database." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,16,12"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="VocabularyPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14"><Button DockPanel.Dock="Right" Content="Export CSV" Click="ExportVocabulary"/><TextBox x:Name="VocabularySearch" TextChanged="SearchChanged" ToolTip="Search expression, reading, meaning, or deck" AutomationProperties.Name="Search vocabulary" Margin="0,0,12,0"/></DockPanel>
          <DataGrid x:Name="VocabularyGrid" Grid.Row="1" MouseDoubleClick="VocabularyDetails"><DataGrid.Columns><DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="160"/><DataGridTextColumn Header="Reading" Binding="{Binding Reading}" Width="160"/><DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="*"/><DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="65"/><DataGridTextColumn Header="Cards" Binding="{Binding Cards}" Width="65"/><DataGridTextColumn Header="Decks" Binding="{Binding Decks}" Width="180"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="VocabularySummary" Foreground="{StaticResource Muted}"/><Button x:Name="SkippedButton" Content="Inspect skipped expressions" Click="ShowSkipped" HorizontalAlignment="Left" Margin="0,8,0,0"/><TextBlock Text="Double-click an entry for supporting note/card IDs. Click column headers to sort." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
        </Grid>
        <ScrollViewer x:Name="CoveragePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Common words and JLPT" FontSize="24" Margin="0,0,0,12"/>
            <TextBlock Text="Known: 永遠 · Familiar: 勉強してる · Coverage: their union. Suspended deck vocabulary counts only toward In database. Counts deduplicate JMdict entries, including duplicate notes and sibling cards." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <StackPanel x:Name="CoverageControls">
              <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="Add missing words to Anki" FontSize="20" Margin="0,0,0,8"/>
                <TextBlock Text="Random, without repeats: N5 → N4 → N3 → N2 → N1 → Common. New notes always go to 日本語::勉強してる using Japanese / Front + English. Sentence and Media stay blank; daily limits are unchanged." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                <WrapPanel><TextBlock Text="Words" VerticalAlignment="Center" Margin="0,0,10,8"/><TextBox x:Name="NewWordCount" Text="10" Width="90" AutomationProperties.Name="Number of new words" Margin="0,0,12,8"/><Button Content="Preview new notes" Click="PreviewNewNotes" Margin="0,0,12,8"/><Button Content="Check pending additions" Click="CheckPendingAdditions" Margin="0,0,0,8"/></WrapPanel>
                <Expander Header="AnkiConnect API key (only if configured)" Foreground="#EFF1F6" Margin="0,0,0,8"><PasswordBox x:Name="AnkiApiKey" Background="#20232B" Foreground="White" Padding="8" MaxWidth="320" HorizontalAlignment="Left" AutomationProperties.Name="AnkiConnect API key"/></Expander>
                <TextBlock x:Name="CreationStatus" Text="Open Anki before previewing. The app checks the live collection for duplicates, then asks you to create the previewed notes. First use may download preferred-form dictionary metadata. No notes are created by Refresh." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
              </StackPanel></Border>
              <WrapPanel Margin="0,0,0,12"><Button Content="Download / reinstall reference data" Click="DownloadCoverageReference" Margin="0,0,12,8"/><Button Content="Reference sources and rules" Click="ShowCoverageSources" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock x:Name="CoverageStatus" Text="Install the versioned reference data once, then matching and reports work offline. Only public dataset files are downloaded; no Anki data is sent." TextWrapping="Wrap" Margin="0,0,0,12"/>
              <DataGrid x:Name="CoverageGrid" Height="345" SelectionMode="Single" Margin="0,0,0,12" AutomationProperties.Name="Reference list coverage"><DataGrid.Columns>
                <DataGridTextColumn Header="Reference list" Binding="{Binding List}" Width="110"/>
                <DataGridTextColumn Header="Known" Binding="{Binding KnownDisplay}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Familiar" Binding="{Binding FamiliarDisplay}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="Combined" Binding="{Binding CombinedDisplay}" Width="*" MinWidth="180"/>
                <DataGridTextColumn Header="In database" Binding="{Binding DatabaseDisplay}" Width="*" MinWidth="180"/>
              </DataGrid.Columns></DataGrid>
              <TextBlock Text="Select a reference-list row to export its missing entries. “Not covered” includes database-only vocabulary; “Absent from database” excludes every confirmed entry in the imported selection. Unresolved matches may appear missing." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
              <WrapPanel Margin="0,0,0,18"><Button Content="Export not covered (.md)" Click="ExportMissingCoverage" Tag="combined" Margin="0,0,12,8"/><Button Content="Export absent from database (.md)" Click="ExportMissingCoverage" Tag="database" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="Inspect Anki matches" FontSize="21" Margin="0,0,0,8"/>
              <WrapPanel Margin="0,0,0,10"><TextBox x:Name="CoverageSearch" Width="220" TextChanged="CoverageFilterChanged" AutomationProperties.Name="Search Anki matches" ToolTip="Search expression, reading, meaning, status or deck" Margin="0,0,12,0"/><ComboBox x:Name="CoverageMatchFilter" SelectedIndex="0" SelectionChanged="CoverageFilterChanged" Margin="0,0,12,0"><ComboBoxItem Content="All matches"/><ComboBoxItem Content="Needs review"/><ComboBoxItem Content="Known / familiar"/><ComboBoxItem Content="Database only"/></ComboBox><Button Content="Review selected match" Click="ReviewCoverageMatch"/></WrapPanel>
              <DataGrid x:Name="CoverageMatchGrid" Height="320" SelectionMode="Single" MouseDoubleClick="ReviewCoverageMatchDoubleClick" AutomationProperties.Name="Anki dictionary matches"><DataGrid.Columns>
                <DataGridTextColumn Header="Word" Binding="{Binding Expression}" Width="120"/><DataGridTextColumn Header="Reading" Binding="{Binding Reading}" Width="130"/><DataGridTextColumn Header="Cohort" Binding="{Binding Cohort}" Width="120"/><DataGridTextColumn Header="Match" Binding="{Binding Status}" Width="120"/><DataGridTextColumn Header="JMdict IDs" Binding="{Binding EntryIdsDisplay}" Width="140"/><DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
              </DataGrid.Columns></DataGrid>
              <TextBlock x:Name="CoverageMatchSummary" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/>
              <Expander Header="Stem families and grouping rules" Foreground="#EFF1F6" Margin="0,0,0,18"><StackPanel>
                <TextBlock x:Name="CoverageFamilySummary" TextWrapping="Wrap" Margin="0,12,0,8"/>
                <TextBlock Text="Conservative rules v1: spelling variants share a dictionary entry; 報う, 報いる and 報われる share one explicitly curated family. Other entries stay separate unless you assign them the same family label in match review. Shared kanji, similar meanings, and transitive/intransitive pairs are not automatically grouped. This limited grouping does not change common/JLPT coverage." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <DataGrid x:Name="CoverageFamilyGrid" Height="200" MouseDoubleClick="CoverageFamilyDetails"><DataGrid.Columns><DataGridTextColumn Header="Family" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Members" Binding="{Binding Members}" Width="*"/><DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="*"/><DataGridTextColumn Header="Entries" Binding="{Binding Entries.Count}" Width="90"/></DataGrid.Columns></DataGrid>
                <TextBlock Text="Double-click a family to inspect its entries and readings." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
              </StackPanel></Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="ReviewsPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,14"><TextBlock Text="Range" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="RangePicker" SelectionChanged="ReviewFilterChanged" SelectedIndex="0" Margin="0,0,18,0"><ComboBoxItem Content="All history"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="Last 90 days"/></ComboBox><TextBlock Text="Events" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="KindPicker" SelectionChanged="ReviewFilterChanged" SelectedIndex="0" Margin="0,0,18,0"><ComboBoxItem Content="Ordinary review"/><ComboBoxItem Content="Learning"/><ComboBoxItem Content="Relearning"/><ComboBoxItem Content="Filtered / cram"/><ComboBoxItem Content="All rated answers"/></ComboBox><ComboBox x:Name="GranularityPicker" SelectionChanged="ChartGroupingChanged" SelectedIndex="1" Margin="0,0,18,0"><ComboBoxItem Content="Daily chart"/><ComboBoxItem Content="Weekly chart"/></ComboBox><Button Content="Export CSV" Click="ExportReviews"/></WrapPanel>
          <TextBlock x:Name="ReviewSummary" Grid.Row="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Answers over time" FontSize="20" Margin="0,0,0,14"/><local:ReviewChart x:Name="HistoryChart" Height="180"/></StackPanel></Border>
            <TextBlock Text="Time of day" FontSize="20" Margin="0,0,0,10"/>
            <DataGrid x:Name="BucketGrid" Height="184" Margin="0,0,16,12"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="*"/><DataGridTextColumn Header="Answers" Binding="{Binding Answers}" Width="100"/><DataGridTextColumn Header="Again" Binding="{Binding Again}" Width="80"/><DataGridTextColumn Header="Again rate" Binding="{Binding AgainDisplay}" Width="110"/><DataGridTextColumn Header="Median answer" Binding="{Binding TimeDisplay}" Width="125"/><DataGridTextColumn Header="Sample" Binding="{Binding Confidence}" Width="120"/></DataGrid.Columns></DataGrid>
            <TextBlock Text="Recorded answer durations may be capped by Anki. Time buckets are descriptive; smaller Again rates do not prove a better time to study." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,18"/>
            <DockPanel Margin="0,0,16,10"><ComboBox x:Name="RankingPicker" DockPanel.Dock="Right" SelectionChanged="RankingChanged" SelectedIndex="0"><ComboBoxItem Content="Most reviewed"/><ComboBoxItem Content="Most Again answers"/></ComboBox><TextBlock Text="Card rankings" FontSize="20"/></DockPanel>
            <TextBlock Text="Rankings always use ordinary reviews in the selected date range. Lifetime lapses come from current card state." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,16,10"/>
            <DataGrid x:Name="RankingGrid" Height="300" Margin="0,0,16,18"><DataGrid.Columns><DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="*"/><DataGridTextColumn Header="Deck" Binding="{Binding Deck}" Width="200"/><DataGridTextColumn Header="Reviews" Binding="{Binding Reviews}" Width="95"/><DataGridTextColumn Header="Again" Binding="{Binding Again}" Width="90"/><DataGridTextColumn Header="Lifetime lapses" Binding="{Binding LifetimeLapses}" Width="125"/><DataGridTextColumn Header="Card ID" Binding="{Binding CardId}" Width="150"/></DataGrid.Columns></DataGrid>
            <Expander Header="Daily answer counts" Foreground="#EFF1F6" Margin="0,0,16,18"><DataGrid x:Name="DailyGrid" Height="240"><DataGrid.Columns><DataGridTextColumn Header="Date" Binding="{Binding Day}" Width="*"/><DataGridTextColumn Header="Answers" Binding="{Binding Answers}" Width="150"/></DataGrid.Columns></DataGrid></Expander>
          </StackPanel></ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="InsightsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ONE OBSERVATION EACH DAY" Foreground="#8FB8EB" FontSize="11"/><TextBlock x:Name="FeaturedTitle" FontSize="28" Margin="0,14,0,12" TextWrapping="Wrap"/><TextBlock x:Name="FeaturedDetail" FontSize="18" TextWrapping="Wrap" LineHeight="28"/></StackPanel></Border><TextBlock Text="Based on all available rated-answer history and the current inventory. Card rankings use ordinary reviews. Today's topic stays the same when you reopen the app; its values update after refresh. A topic will not repeat within seven calendar days." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,16,20"/><TextBlock Text="This discovery library uses review patterns and vocabulary inventory. Common-word and JLPT statistics are available in Word Coverage; rarity insights require a separate frequency source." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,16,0"/></StackPanel></ScrollViewer>
        <ScrollViewer x:Name="CalendarPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Review streaks" FontSize="23" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Deck profile" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="CalendarProfilePicker" ItemsSource="{Binding ItemsSource, ElementName=ActiveProfilePicker}" SelectedItem="{Binding SelectedItem, ElementName=ActiveProfilePicker, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=ActiveProfilePicker}" DisplayMemberPath="Name" MinWidth="220" AutomationProperties.Name="Calendar deck profile"/></StackPanel>
            <TextBlock x:Name="CalendarStatus" Text="Connect and refresh a collection to see your review streaks." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
            <TextBlock Text="Streak range" Margin="0,0,0,6"/>
            <ComboBox x:Name="StreakPicker" DisplayMemberPath="Label" SelectionChanged="StreakChanged" AutomationProperties.Name="Streak range" HorizontalAlignment="Left" MaxWidth="650" Margin="0,0,0,18" IsEnabled="False"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock x:Name="StreakSummary" Text="No streak selected" FontSize="20" TextWrapping="Wrap" Margin="0,0,0,16"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,30,0,0"><TextBlock Text="Sun" Height="28"/><TextBlock Text="Mon" Height="28"/><TextBlock Text="Tue" Height="28"/><TextBlock Text="Wed" Height="28"/><TextBlock Text="Thu" Height="28"/><TextBlock Text="Fri" Height="28"/><TextBlock Text="Sat" Height="28"/></StackPanel>
                <ScrollViewer x:Name="CalendarScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><local:StreakCalendar x:Name="CalendarHeatmap" HorizontalAlignment="Left"/></ScrollViewer>
              </Grid>
              <WrapPanel Margin="42,18,0,0">
                <StackPanel Margin="0,0,24,12"><TextBlock Text="Blue · 1–499 answers" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" Background="#B5DCF2" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#87BDDF" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#5899C8" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#326FA9" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#204B82"/></StackPanel></StackPanel>
                <StackPanel Margin="0,0,24,12"><TextBlock Text="Purple · 500–999 answers" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" Background="#E0C9F5" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#C6A0E7" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#AA78D3" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#8B51BA" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#69358F"/></StackPanel></StackPanel>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Gold · 1,000+ answers" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" Background="#FFF0B3" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#F5D778" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#E7BA43" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#CC9826" Margin="0,0,4,0"/><Border Width="18" Height="18" Background="#A87717"/></StackPanel></StackPanel>
              </WrapPanel>
              <TextBlock x:Name="CalendarDay" TextWrapping="Wrap" Margin="42,8,0,0"/>
              <TextBlock Text="Darker shades mean more answers within each color range. Blue and purple use fixed ranges; gold scales from 1,000 to the busiest day in this streak. Hover or click a day for its count. Use arrow keys when the calendar is focused; Home / End jump to the first / last day. Scroll horizontally to explore long streaks." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <TextBlock x:Name="CalendarScope" Text="Study days run from 4 AM to 4 AM in the selected review time zone. A complete day with no rated answers ends a streak. Today stays open until the next 4 AM cutoff." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="TimeAnalysisPage" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12"><TextBlock Text="Range" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="TimeRangePicker" AutomationProperties.Name="Time analysis range" SelectionChanged="TimeRangeChanged" SelectedIndex="3" Margin="0,0,18,0"><ComboBoxItem Content="All history"/><ComboBoxItem Content="Last 30 days"/><ComboBoxItem Content="Last 90 days"/><ComboBoxItem Content="Last 6 months"/></ComboBox><ComboBox x:Name="TimeGroupingPicker" AutomationProperties.Name="Time chart grouping" SelectionChanged="TimeGroupingChanged" SelectedIndex="0"><ComboBoxItem Content="Daily"/><ComboBoxItem Content="Weekly"/></ComboBox></WrapPanel>
          <TextBlock x:Name="TimeScope" Grid.Row="1" Text="Connect a collection for recorded review-time analysis." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
            <UniformGrid Columns="2">
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recorded time · selected range" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedHours" Text="—" FontSize="28" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Average / median seconds per answer" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedAnswerTime" Text="—" FontSize="28" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Average per calendar study day" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedDailyTime" Text="—" FontSize="28" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Average per seven days" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelectedWeeklyTime" Text="—" FontSize="28" Margin="0,8,0,0"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Time spent over time" FontSize="20"/>
              <TextBlock x:Name="TimeChartCaption" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,10"/>
              <WrapPanel Margin="0,0,0,12"><TextBlock x:Name="AllTimeAverageLegend" Foreground="LightGray" Margin="0,0,24,0"/><TextBlock x:Name="RecentTimeAverageLegend" Foreground="Goldenrod"/></WrapPanel>
              <local:TimeChart x:Name="TimeHistoryChart" Height="220"/>
            </StackPanel></Border>
            <TextBlock Text="Recent time versus all-history averages" FontSize="20" Margin="0,0,0,10"/>
            <TextBlock Text="Six months means six calendar months back from the current study date. Averages include zero-review dates from the later of the range start or the first available answer. Weekly averages are daily averages × 7. Today may be incomplete." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,10"/>
            <DataGrid x:Name="TimeComparisonGrid" Height="395" Margin="0,0,16,18"><DataGrid.Columns><DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="250"/><DataGridTextColumn Header="All history" Binding="{Binding AllHistory}" Width="*"/><DataGridTextColumn Header="Last 6 months" Binding="{Binding Recent}" Width="*"/></DataGrid.Columns></DataGrid>
            <TextBlock Text="By weekday · selected range" FontSize="20" Margin="0,0,0,10"/>
            <TextBlock Text="Weekdays use the 4 AM study date. Average minutes divides by occurrences of that weekday, including zero-review dates." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,10"/>
            <DataGrid x:Name="WeekdayTimeGrid" Height="300" Margin="0,0,16,18"><DataGrid.Columns><DataGridTextColumn Header="Weekday" Binding="{Binding Period}" Width="*"/><DataGridTextColumn Header="Hours" Binding="{Binding Stats.HoursDisplay}" Width="100"/><DataGridTextColumn Header="Avg min/day" Binding="{Binding AverageMinutes}" Width="115"/><DataGridTextColumn Header="Avg sec" Binding="{Binding Stats.MeanDisplay}" Width="90"/><DataGridTextColumn Header="Median sec" Binding="{Binding Stats.MedianDisplay}" Width="100"/><DataGridTextColumn Header="Timed answers" Binding="{Binding Stats.TimedAnswers}" Width="120"/></DataGrid.Columns></DataGrid>
            <TextBlock Text="By hour · selected range" FontSize="20" Margin="0,0,0,10"/>
            <TextBlock Text="Hours use local wall-clock time; 00:00–03:59 belongs to the previous study date. Average minutes divides by all calendar study dates. Repeated daylight-saving hours are combined." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,10"/>
            <DataGrid x:Name="HourlyTimeGrid" Height="330" Margin="0,0,16,18"><DataGrid.Columns><DataGridTextColumn Header="Hour" Binding="{Binding Period}" Width="*"/><DataGridTextColumn Header="Hours" Binding="{Binding Stats.HoursDisplay}" Width="100"/><DataGridTextColumn Header="Avg min/day" Binding="{Binding AverageMinutes}" Width="115"/><DataGridTextColumn Header="Avg sec" Binding="{Binding Stats.MeanDisplay}" Width="90"/><DataGridTextColumn Header="Median sec" Binding="{Binding Stats.MedianDisplay}" Width="100"/><DataGridTextColumn Header="Timed answers" Binding="{Binding Stats.TimedAnswers}" Width="120"/></DataGrid.Columns></DataGrid>
            <Expander Header="Exact daily / weekly time totals" Foreground="#EFF1F6" Margin="0,0,16,18"><DataGrid x:Name="TimePeriodsGrid" Height="300"><DataGrid.Columns><DataGridTextColumn Header="Period" Binding="{Binding Period}" Width="*"/><DataGridTextColumn Header="Minutes" Binding="{Binding MinutesDisplay}" Width="100"/><DataGridTextColumn Header="Answers" Binding="{Binding Stats.Answers}" Width="100"/><DataGridTextColumn Header="Timed answers" Binding="{Binding Stats.TimedAnswers}" Width="120"/><DataGridTextColumn Header="Avg sec" Binding="{Binding Stats.MeanDisplay}" Width="90"/><DataGridTextColumn Header="Median sec" Binding="{Binding Stats.MedianDisplay}" Width="100"/></DataGrid.Columns></DataGrid></Expander>
            <TextBlock Text="Time is the sum of Anki's positive recorded answer durations, which may be capped and do not include all time spent studying. Zero or missing durations are excluded from time totals, averages, and medians; their answers still count toward activity. All learning, review, relearning, and filtered rated answers are included. Administrative and unknown events are excluded. Statistics describe recorded activity, not the cause of better performance." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,16,16"/>
          </StackPanel></ScrollViewer>
        </Grid>
        <Grid x:Name="LearningPage" Visibility="Collapsed">
          <Grid.Resources><Style x:Key="LearningCell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/></Style></Grid.Resources>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="LearningScope" Text="Connect and refresh a collection to inspect learning patterns." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
          <WrapPanel x:Name="LearningControls" Grid.Row="1" Margin="0,0,0,10">
            <ComboBox x:Name="LearningViewPicker" SelectedIndex="0" SelectionChanged="LearningViewChanged" AutomationProperties.Name="Learning analysis view" Margin="0,0,12,8"><ComboBoxItem Content="Difficulty candidates"/><ComboBoxItem Content="Cross-deck comparison"/><ComboBoxItem Content="Shared patterns"/></ComboBox>
            <ComboBox x:Name="LearningCohortPicker" SelectedIndex="0" SelectionChanged="LearningFilterChanged" AutomationProperties.Name="Difficulty cohort" Margin="0,0,12,8"><ComboBoxItem Content="All candidates"/><ComboBoxItem Content="3+ historical lapses"/><ComboBoxItem Content="Active · 3+ historical lapses"/><ComboBoxItem Content="Recovery / suspended"/><ComboBoxItem Content="3+ recent lapses"/><ComboBoxItem Content="Unresolved character readings"/></ComboBox>
            <ComboBox x:Name="LearningKindPicker" SelectionChanged="LearningFilterChanged" AutomationProperties.Name="Learning pattern category" Visibility="Collapsed" Margin="0,0,12,8"/>
            <TextBox x:Name="LearningSearch" TextChanged="LearningSearchChanged" Width="215" AutomationProperties.Name="Search learning patterns" ToolTip="Search word, reading, meaning, deck, or pattern" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock x:Name="LearningResultCount" Grid.Row="2" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"/>
          <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
            <DataGrid x:Name="LearningFindingsGrid" Visibility="Collapsed" SelectionChanged="LearningFindingChanged" AutomationProperties.Name="Learning pattern findings"><DataGrid.Columns><DataGridTextColumn Header="Category" Binding="{Binding Kind}" Width="160"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="150"/><DataGridTextColumn Header="Flagged words" Binding="{Binding FlaggedWords}" Width="110"/><DataGridTextColumn Header="Recent Again" Binding="{Binding RecentLapses}" Width="110"/><DataGridTextColumn Header="Evidence" Binding="{Binding Confidence}" Width="*"/></DataGrid.Columns></DataGrid>
            <TextBlock x:Name="LearningEvidence" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Margin="0,10" Visibility="Collapsed"/>
            <DataGrid x:Name="LearningCardsGrid" Grid.RowSpan="3" MouseDoubleClick="LearningCardDetails" AutomationProperties.Name="Learning evidence cards"><DataGrid.Columns><DataGridTextColumn Header="Word / kanji" Binding="{Binding Word}" Width="120"/><DataGridTextColumn Header="Reading" Binding="{Binding Reading}" Width="120"/><DataGridTextColumn Header="Meaning" Binding="{Binding Meaning}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Reason / state" Binding="{Binding Reason}" Width="155"/><DataGridTextColumn Header="Historical Again" Binding="{Binding Lapses}" Width="120"/><DataGridTextColumn Header="Recent Again / answers" Binding="{Binding RecentDisplay}" Width="165"/><DataGridTextColumn Header="Current lapses" Binding="{Binding StoredLapses}" Width="110"/><DataGridTextColumn Header="Ordinary answers" Binding="{Binding Reviews}" Width="130"/><DataGridTextColumn Header="Deck" Binding="{Binding Deck}" Width="210"/></DataGrid.Columns></DataGrid>
          </Grid>
          <Expander Grid.Row="4" Header="How findings are measured · double-click a card for its review evidence" Foreground="#EFF1F6" Margin="0,12,0,0"><ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><TextBlock Text="Three historical lapses means three Again answers during ordinary reviews, across all available history. Learning/relearning repetitions, Hard ratings, administrative records, and future events do not count. Recent counts use the last six calendar months and 4 AM study dates. Current Anki lapse counters are shown separately because they can differ from retained history.&#10;&#10;日本語::永遠 is always excluded from difficulty rankings. 日本語::Seen in Immersion is ignored. 日本語::Suspended and 漢字::Relearn are recovery groups, including new and suspended cards; placement alone is not proof of review failure. 漢字::Unused is reference data, excluded from difficulty rankings. Grammar is outside this analysis.&#10;&#10;Japanese cards test reading and meaning together, while the Kanji deck tests meaning. A shared kanji, reading, written form, or English gloss is an association, not a demonstrated cause of failure. English glosses can have multiple senses; written-form matches compare characters rather than strokes. Only explicit furigana supports character-reading attribution; ambiguous compound readings remain unresolved. Known vocabulary appears only as supporting context in cross-deck comparisons. Results reflect the imported scope and available card-linked history. No Anki data is changed." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,12,0"/></ScrollViewer></Expander>
        </Grid>
        <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SettingsContent">
            <TextBlock Text="Connect your collection" FontSize="22" Margin="0,0,0,8"/><TextBlock Text="Close Anki before inspecting or refreshing. Select the profile folder that contains collection.anki2." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
            <DockPanel Margin="0,0,0,18"><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseProfile"/><Button Content="Inspect profile" DockPanel.Dock="Right" Click="InspectProfile"/><TextBox x:Name="ProfilePath" IsReadOnly="True" Margin="0,0,12,0" AutomationProperties.Name="Anki profile folder"/></DockPanel>
            <TextBlock Text="Deck profiles" FontSize="21" Margin="0,0,0,8"/>
            <TextBlock Text="Select a profile to edit its deck rules below. Rename profiles and enable the ones you want to analyze; enabled profiles appear in the active-profile picker and each gets a Review rhythm chart. Preview and save to apply changes. Field mappings and time zone are shared." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <DataGrid x:Name="ProfilesGrid" Height="160" IsReadOnly="False" SelectionChanged="EditorProfileChanged" Margin="0,0,16,10" AutomationProperties.Name="Saved deck profiles"><DataGrid.Columns><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="85"/><DataGridTextColumn Header="Profile name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
            <WrapPanel Margin="0,0,0,14"><Button Content="Add profile" Click="AddProfile"/><Button Content="Remove selected profile" Click="RemoveProfile"/></WrapPanel>
            <TextBlock x:Name="EditingProfileLabel" Text="Deck rules for selected profile" FontSize="18" Margin="0,0,0,8"/>
            <TextBlock Text="Include a parent to include its descendants. Exclude a subtree to omit it. Inherit follows the nearest parent rule; the default is excluded. Counts shown are direct card counts." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
            <DataGrid x:Name="DeckGrid" Height="200" IsReadOnly="False" Margin="0,0,16,20"><DataGrid.Columns><DataGridTextColumn Header="Deck" Binding="{Binding Name}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Cards" Binding="{Binding Cards}" Width="90" IsReadOnly="True"/><DataGridTemplateColumn Header="Rule" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
            <TextBlock Text="Note types and fields" FontSize="21" Margin="0,0,0,8"/><TextBlock Text="Only vocabulary types contribute to the inventory. Kanji and grammar types contribute reviews. Suggestions need your confirmation. Bracket readings is an explicit option for fields such as 漢字[かんじ]." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,16,12"/>
            <DataGrid x:Name="MappingGrid" Height="270" IsReadOnly="False" Margin="0,0,16,20"><DataGrid.Columns>
              <DataGridTextColumn Header="Note type" Binding="{Binding Name}" Width="160" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="Category" Width="135"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Expression" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding RequiredFields}" SelectedItem="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Reading" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OptionalFields}" SelectedItem="{Binding Reading, UpdateSourceTrigger=PropertyChanged}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Meaning" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding OptionalFields}" SelectedItem="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" Padding="5,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridCheckBoxColumn Header="Bracket readings" Binding="{Binding StripBracketReadings, UpdateSourceTrigger=PropertyChanged}" Width="125"/>
            </DataGrid.Columns></DataGrid>
            <DockPanel Margin="0,0,16,20"><TextBlock Text="Review time zone" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="TimeZonePicker" DisplayMemberPath="DisplayName" SelectedValuePath="Id"/></DockPanel>
            <WrapPanel Margin="0,0,0,16"><Button Content="Preview selection" Click="PreviewSelection"/><Button Content="Save and refresh" Click="SaveSettings" Background="#3D659B"/><Button Content="Open app data folder" Click="OpenDataFolder"/></WrapPanel>
            <Border Style="{StaticResource Card}"><TextBlock x:Name="PreviewText" Text="Inspect a profile, choose your decks and mappings, then preview before saving." TextWrapping="Wrap" LineHeight="23"/></Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <TextBlock x:Name="Footer" Grid.Row="4" Text="Phase 1A · local collection analysis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
  </Grid>
</Window>
